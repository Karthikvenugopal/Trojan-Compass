# demo: fixed offline fixture (no provider/database calls).
# diagnostic: every chat returns a labeled dummy; no provider/graph calls.
# campus: AI-led conversation + real evidence engine + USC snapshot (no database needed).
# production: Configured LLM extraction + real engine + configured Neo4j database.
COMPASS_MODE=demo
# Campus/production only. Credentials stay server-side; never prefix with VITE_.
LLM_PROVIDER=ollama
# Local installed model; no automatic download or cloud fallback.
OLLAMA_MODEL=qwen3:4b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CONTEXT_LENGTH=32768
# Set LLM_PROVIDER=openai to use these cloud credentials instead.
OPENAI_API_KEY=
OPENAI_MODEL=
# Set LLM_PROVIDER=gemini to select these instead. Use a plain supported model ID.
GEMINI_API_KEY=
GEMINI_MODEL=
# Optional server-selected public graph import file; never student data.
COMPASS_SEED_PATH=
# Campus only. Defaults to data/usc/catalog.json (from scripts/fetch_usc_catalog.py).
COMPASS_CATALOG_PATH=
# Campus only. Defaults to data/usc/campus_kb.json (from scripts/fetch_campus_kb.py).
COMPASS_KB_PATH=
# Production only. Import reviewed shared data separately with trojan-compass-import.
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Explicit browser origins for direct API calls; empty disables cross-origin access.
COMPASS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
