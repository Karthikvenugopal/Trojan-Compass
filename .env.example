# demo: fixed offline fixture (no provider/database calls).
# campus: Configured LLM extraction + real engine + reviewed USC seed (no database needed).
# production: Configured LLM extraction + real engine + configured Neo4j database.
COMPASS_MODE=demo
# Campus/production only. Credentials stay server-side; never prefix with VITE_.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=
# Set LLM_PROVIDER=gemini to select these instead. Use a plain supported model ID.
GEMINI_API_KEY=
GEMINI_MODEL=
# Optional server-selected public graph import file; never student data.
COMPASS_SEED_PATH=
# Production only. Import reviewed shared data separately with trojan-compass-import.
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
